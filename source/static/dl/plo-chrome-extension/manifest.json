{
  "manifest_version": 3,
  "name": "PLOEXT",
  "version": "9.0",
  "description": "PLO remote table control - scrapes PokerBet table, sends to 127.0.0.1:4000/remote",
  "host_permissions": [
    "http://127.0.0.1:4000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pokerbet.co.za/*",
        "*://*.goldrushnation.com/*",
        "*://*.127.0.0.1:4000/*",
        "*://*.skillgames-bc.com/*",
        "*://*.skillgames.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {}
}
