"""
result_parser.py
================
Parses ANSI-stripped PLO equity engine output into structured JSON
suitable for the React frontend to render.

Also contains the full batch-parser pipeline used by the
/api/batch/* endpoints:

  parse_batch_text(raw)          -> list[SampleResult]
  validate_sample(sample)        -> ValidationResult
  normalize_sample(sample)       -> SampleResult  (keys renamed)
  build_pair_dataset(samples)    -> list[PairRow]
  extract_best_pair(samples)     -> list[PairRow]  (1 per sample)
  compare_winners(samples)       -> list[PairRow]  (ranked by EV)
  filter_pairs(rows, mode)       -> list[PairRow]

Market-model field mapping
--------------------------
  Engine name    -> Market model name
  underdog       -> BUY
  favourite      -> REVERSE BUYER
  und_raw        -> PRICE
  und_real       -> Reverse Buy Hit %
  fav_raw        -> RvsPrice
  fav_real       -> HitRate %
  disparity      -> EV
"""
import re


def _strip_ansi(text: str) -> str:
    return re.sub(r'\x1b\[[0-9;]*m', '', text)


def parse_results(lines_text: str) -> dict:
    """
    Parse the full ANSI-stripped engine output text into a structured dict.
    Returns:
        {
            "street":  "FLOP",
            "runtime": "4.93s",
            "cores":   4,
            "pairs_evaluated": 36,
            "players": [{"slot":1,"hand":"AhKhQdJd","name":"hero"}, ...],
            "matchups": [
                {
                    "rank": 1, "pair_num": 34,
                    "underdog_hand": "3s2hAsKs", "underdog_name": "Player7",
                    "favourite_hand": "QcJcTh9h", "favourite_name": "Player8",
                    "und_raw": 19.8171, "und_real": 3.2051,
                    "disparity": -16.6119,
                    "fav_raw": 80.1829, "fav_real": 96.7949,
                },
                ...
            ]
        }
    """

    # ── Street ───────────────────────────────────────────────────────────────
    street_m = re.search(r'Street\s{5,}(\S+)', lines_text)
    street = street_m.group(1) if street_m else "UNKNOWN"

    # ── Runtime ───────────────────────────────────────────────────────────────
    rt_m = re.search(r'Total runtime\s+([\d.]+(?:s|m \d+\.\d+s))', lines_text)
    runtime = rt_m.group(1) if rt_m else ""

    # ── Cores ────────────────────────────────────────────────────────────────
    cores_m = re.search(r'CPU cores used\s+(\d+)', lines_text)
    cores = int(cores_m.group(1)) if cores_m else 1

    # ── Pairs evaluated ───────────────────────────────────────────────────────
    pairs_m = re.search(r'Pairs evaluated\s+(\d+)', lines_text)
    pairs = int(pairs_m.group(1)) if pairs_m else 0

    # ── Players ──────────────────────────────────────────────────────────────
    # Lines like:   "  Player  1  AhKhQdJd       (hero)  ->  ..."
    player_pat = re.compile(
        r'Player\s+(\d+)\s+(\w{8,10})\s+\(([^)]+)\)',
        re.MULTILINE
    )
    players = []
    seen_slots = set()
    for m in player_pat.finditer(lines_text):
        slot = int(m.group(1))
        if slot not in seen_slots:
            seen_slots.add(slot)
            players.append({
                "slot": slot,
                "hand": m.group(2),
                "name": m.group(3).strip(),
            })
    players.sort(key=lambda p: p["slot"])

    # ── Ranked matchup table ──────────────────────────────────────────────────
    # Only parse rows from the "ALL MATCHUPS" section onwards
    split = lines_text.split("ALL MATCHUPS")
    ranked_section = split[1] if len(split) > 1 else lines_text

    # Each row (after ANSI strip) looks like:
    #    1    1  AhKhQdJd (hero)          Ts9s8c7c (villan)        45.1234%   46.2345%  +  1.1111%   54.8766%   53.7655%
    # Disparity can be:
    #   positive: "+   1.1111%"  (dsn='+' prepended, then right-aligned float)
    #   negative: "  -16.6119%"  (dsn='', float has own minus)
    #   zero:     "   0.0000%"

    row_pat = re.compile(
        r'^\s{2,}(\d+)\s{2,}(\d+)\s+'         # rank, pair_num
        r'(\w+)\s+\(([^)]+?)\)\s+'             # underdog hand (name)
        r'(\w+)\s+\(([^)]+?)\)\s+'             # favourite hand (name)
        r'([\d.]+)%\s+'                         # und_raw
        r'([\d.]+)%\s+'                         # und_real
        r'([+\-]?\s*[\d.]+)%\s+'               # disparity (sign + optional space + digits)
        r'([\d.]+)%\s+'                         # fav_raw
        r'([\d.]+)%',                           # fav_real
        re.MULTILINE,
    )

    matchups = []
    for m in row_pat.finditer(ranked_section):
        # Disparity may be "+   1.1111" – strip spaces before converting
        disp_raw = m.group(9).replace(' ', '')
        try:
            disp = float(disp_raw)
        except ValueError:
            disp = 0.0

        matchups.append({
            "rank":           int(m.group(1)),
            "pair_num":       int(m.group(2)),
            "underdog_hand":  m.group(3),
            "underdog_name":  m.group(4).strip(),
            "favourite_hand": m.group(5),
            "favourite_name": m.group(6).strip(),
            "und_raw":        float(m.group(7)),
            "und_real":       float(m.group(8)),
            "disparity":      disp,
            "fav_raw":        float(m.group(10)),
            "fav_real":       float(m.group(11)),
        })

    # Fallback: parse per-pair blocks if ranked table had no matches
    if not matchups:
        pair_pat = re.compile(
            r'Pair\s+(\d+)/\d+.*?'
            r'Underdog:\s+(\w+)\s+\(([^)]+)\)\s+raw\s+([\d.]+)%\s+realized\s+([\d.]+)%\s+disparity\s+([+\-]?[\d.]+)%.*?'
            r'Favourite:\s+(\w+)\s+\(([^)]+)\)\s+raw\s+([\d.]+)%\s+realized\s+([\d.]+)%',
            re.DOTALL
        )
        for rank, pm in enumerate(pair_pat.finditer(ranked_section), 1):
            matchups.append({
                "rank": rank,
                "pair_num": int(pm.group(1)),
                "underdog_hand": pm.group(2),
                "underdog_name": pm.group(3).strip(),
                "favourite_hand": pm.group(7),
                "favourite_name": pm.group(8).strip(),
                "und_raw": float(pm.group(4)),
                "und_real": float(pm.group(5)),
                "disparity": float(pm.group(6)),
                "fav_raw": float(pm.group(9)),
                "fav_real": float(pm.group(10)),
            })

    # Sort ascending by disparity (most negative = best underdog first)
    matchups.sort(key=lambda r: r["disparity"])

    return {
        "street":          street,
        "runtime":         runtime,
        "cores":           cores,
        "pairs_evaluated": pairs,
        "players":         players,
        "matchups":        matchups,
    }


