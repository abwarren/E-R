server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    # Engine UI - React app built in /opt/plo-engine-backend/static/
    location /engine/ {
        alias /opt/plo-engine-backend/static/;
        index engine-index.html;
        try_files $uri $uri/ /engine/engine-index.html;
        add_header Access-Control-Allow-Origin *;
    }

    # Engine API proxy
    location /engine/api/ {
        rewrite ^/engine(/api/.*)$ $1 break;
        proxy_pass http://127.0.0.1:5002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # Root serves the existing app (keep existing behavior)
    location / {
        proxy_pass http://127.0.0.1:5002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
